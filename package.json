{
  "name": "kitchensim",
  "version": "1.0.0",
  "description": "Interactive household kitchen workflow and ergonomics simulation.",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"require('fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test .test-dist/tests/simulation.test.js",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "babylonjs",
    "simulation",
    "kitchen",
    "ergonomics"
  ],
  "author": "@xtreemze",
  "license": "MIT",
  "dependencies": {
    "@babylonjs/core": "^7.37.0",
    "@babylonjs/gui": "^7.37.0",
    "@babylonjs/inspector": "^7.37.0",
    "@babylonjs/loaders": "^7.37.0",
    "@babylonjs/materials": "^7.37.0",
    "@babylonjs/procedural-textures": "^7.37.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  }
}
